[Unit]
Description=FLAKE Server
After=network.target

[Service]
WorkingDirectory=/usr/bin/larkum/flake
ExecStart=/bin/bash -c 'cd /usr/bin/larkum/flake/ && source .venv/bin/activate && .venv/bin/python3 src/app.py' 
EnvironmentFile=/usr/bin/larkum/flake/.env
Type=simple 
Restart=on-failure

[Install]
WantedBy=default.target
